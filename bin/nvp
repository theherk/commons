#!/usr/bin/env sh

# One nvim per project. The socket lives at a short, private path from `zop tmp`, so
# every reader (Rex, Zellij, the theme toggle) computes the same one. If a server is
# listening there, send the files to it; otherwise start nvim listening on it.

root=$(git root 2>/dev/null)
if [ -n "$root" ] && sock=$(zop tmp "$root" nvim.sock --create 2>/dev/null); then
	if zop tmp "$root" nvim.sock --live; then
		line=""
		files=""
		for arg in "$@"; do
			case "$arg" in
				+*) line="${arg#+}" ;;
				*) files="$arg" ;;
			esac
		done
		nvim --server "$sock" --remote "$files" </dev/null >/dev/null 2>&1
		if [ -n "$line" ]; then
			nvim --server "$sock" --remote-expr "nvim_win_set_cursor(0, [$line, 0])" </dev/null >/dev/null 2>&1
		fi
	else
		# exec unless yazi needs the cleanup below, so terminals see nvim
		# as the foreground program (Rex picks its tab icon from it).
		[ -n "$YAZI_ID" ] || exec nvim --listen "$sock" "$@"
		nvim --listen "$sock" "$@"
	fi
else
	[ -n "$YAZI_ID" ] || exec nvim "$@"
	nvim "$@"
fi

if [ -n "$YAZI_ID" ]; then
	ya emit-to "$YAZI_ID" quit >/dev/null 2>&1
fi
