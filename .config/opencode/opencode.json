{
  "$schema": "https://opencode.ai/config.json",
  "model": "raicode/anthropic/claude-sonnet-5",
  "small_model": "raicode/anthropic/claude-haiku-4-5",
  "permission": {
    "bash": {
      "*": "allow",
      "git push*": "ask"
    },
    "external_directory": {
      "~/vaults/brain/*": "allow",
      "~/Library/CloudStorage/OneDrive-DNBBankASA/dnbrain/*": "allow",
      "~/projects/*": "allow",
      "/tmp/*": "allow",
      "/var/folders/*": "allow"
    }
  },
  "agent": {
    "build": {
      "color": "error",
      "permission": {
        "edit": "allow",
        "bash": "allow",
        "read": "allow",
        "glob": "allow",
        "grep": "allow"
      }
    },
    "explore": {
      "disable": true,
      "color": "success",
      "mode": "primary",
      "description": "Read-only codebase exploration. No writes, minimal bash.",
      "model": "raicode/anthropic/claude-haiku-4-5",
      "permission": {
        "edit": "deny",
        "bash": {
          "*": "deny",
          "git log*": "allow",
          "git diff*": "allow",
          "git status*": "allow",
          "git show*": "allow"
        },
        "read": "allow",
        "glob": "allow",
        "grep": "allow",
        "skill": "allow",
        "task": {
          "*": "deny",
          "jira-work": "allow",
          "nabu": "allow"
        },
        "webfetch": "allow"
      }
    },
    "plan": {
      "color": "warning",
      "permission": {
        "edit": "deny",
        "bash": "deny",
        "task": {
          "*": "deny",
          "jira-work": "allow",
          "nabu": "allow"
        }
