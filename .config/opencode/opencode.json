  "mcp": {
    "servers": {
      "semble": {
        "type": "local",
        "command": [
          "uvx",
          "--from",
          "semble[mcp]",
          "semble"
        ]
      },
      "atlassian": {
        "type": "remote",
        "url": "https://mcp.atlassian.com/v1/mcp/authv2"
      },
      "developer-portal": {
        "type": "remote",
        "url": "https://mcp.prod.devportal.tech-03.net/app/mcp",
        "oauth": {
          "client_id": "b46c2f7c-a5bf-4780-af75-123c72c11f82"
        }
      },
      "developer-portal-provider": {
        "type": "remote",
        "url": "https://mcp.prod.devportal.tech-03.net/provider/mcp",
        "oauth": false,
        "headers": {
          "X-API-Key": "{env:DEVELOPER_PORTAL_API_KEY}",
          "X-App-Id": "{env:DEVELOPER_PORTAL_APP_ID}"
        }
      }
    }
  }
