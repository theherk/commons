    },
    "boob": {
      "model": "raicode/anthropic/claude-haiku-4-5"
    },
    "jira-work": {
      "model": "raicode/anthropic/claude-haiku-4-5"
    },
    "review": {
      "model": "raicode/anthropic/claude-opus-5-5"
    },
    "sage": {
      "model": "raicode/anthropic/claude-opus-5-5"
    }
  },
