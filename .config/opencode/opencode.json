{
  "$schema": "https://opencode.ai/config.json",
  "model": "raicode/anthropic/claude-sonnet-5-5",
  "default_agent": "build",
  "update": "disable",
  "permissions": [
    {
      "action": "shell",
      "resource": "git push *",
      "effect": "ask"
    },
    {
      "action": "shell",
      "resource": "rtk git push *",
      "effect": "ask"
    },
    {
      "action": "external_directory",
      "resource": "~/vaults/brain/*",
      "effect": "allow"
    },
    {
      "action": "external_directory",
      "resource": "~/Library/CloudStorage/OneDrive-DNBBankASA/dnbrain/*",
      "effect": "allow"
    },
    {
      "action": "external_directory",
      "resource": "~/projects/*",
      "effect": "allow"
    },
    {
      "action": "external_directory",
      "resource": "/tmp/*",
      "effect": "allow"
    },
    {
      "action": "external_directory",
      "resource": "/private/tmp/*",
      "effect": "allow"
    },
    {
      "action": "external_directory",
      "resource": "/var/folders/*",
      "effect": "allow"
    },
    {
      "action": "external_directory",
      "resource": "/private/var/folders/*",
      "effect": "allow"
    }
  ],
  "agents": {
    "build": {
      "color": "#f38ba8"
    },
    "plan": {
      "color": "#f9e2af",
      "permissions": [
        {
          "action": "shell",
          "resource": "*",
          "effect": "deny"
        },
        {
          "action": "subagent",
          "resource": "*",
          "effect": "deny"
        },
        {
          "action": "subagent",
          "resource": "jira-work",
          "effect": "allow"
        },
        {
          "action": "subagent",
          "resource": "nabu",
          "effect": "allow"
        }
      ]
    },
    "explore": {
      "disabled": true
    },
    "title": {
      "model": "raicode/anthropic/claude-haiku-4-5"
    },
    "boob": {
      "model": "raicode/anthropic/claude-haiku-4-5"
    },
    "jira-work": {
      "description": "Query and manage Jira work items via acli. Use for sprint status lookups, issue transitions, comments, and issue linking on the CCPLAT board.",
      "mode": "subagent",
      "model": "raicode/anthropic/claude-haiku-4-5",
      "system": "{file:~/.agents/skills/jira-work/SKILL.md}",
      "permissions": [
        {
          "action": "edit",
          "resource": "*",
          "effect": "deny"
        },
        {
          "action": "shell",
          "resource": "*",
          "effect": "allow"
        },
        {
          "action": "read",
          "resource": "*",
          "effect": "deny"
        },
        {
          "action": "glob",
          "resource": "*",
          "effect": "deny"
        },
        {
          "action": "grep",
          "resource": "*",
          "effect": "deny"
        }
      ]
    },
    "review": {
      "description": "Isolated patch reviewer. Receives only a repo path and optional ref/range. No project memory, no session context. Can read code and run git to understand how changes fit the codebase.",
      "mode": "subagent",
      "color": "#89dceb",
      "model": "raicode/anthropic/claude-opus-5-5",
      "system": "{file:~/.agents/skills/review/SKILL.md}\n\n{file:~/.config/opencode/prompts/review.md}",
      "permissions": [
        {
          "action": "edit",
          "resource": "*",
          "effect": "deny"
        },
        {
          "action": "shell",
          "resource": "*",
          "effect": "deny"
        },
        {
          "action": "shell",
          "resource": "cd *",
          "effect": "allow"
        },
        {
          "action": "shell",
          "resource": "git diff *",
          "effect": "allow"
        },
        {
          "action": "shell",
          "resource": "rtk git diff *",
          "effect": "allow"
        },
        {
          "action": "shell",
          "resource": "git show *",
          "effect": "allow"
        },
        {
          "action": "shell",
          "resource": "rtk git show *",
          "effect": "allow"
        },
        {
          "action": "shell",
          "resource": "git log *",
          "effect": "allow"
        },
        {
          "action": "shell",
          "resource": "rtk git log *",
          "effect": "allow"
        },
        {
          "action": "shell",
          "resource": "git status *",
          "effect": "allow"
        },
        {
          "action": "shell",
          "resource": "rtk git status *",
          "effect": "allow"
        },
        {
          "action": "shell",
          "resource": "git rev-parse *",
          "effect": "allow"
        },
        {
          "action": "shell",
          "resource": "rtk git rev-parse *",
          "effect": "allow"
        },
        {
          "action": "shell",
          "resource": "jj diff *",
          "effect": "allow"
        },
        {
          "action": "shell",
          "resource": "rtk jj diff *",
          "effect": "allow"
        },
        {
          "action": "shell",
          "resource": "jj show *",
          "effect": "allow"
        },
        {
          "action": "shell",
          "resource": "rtk jj show *",
          "effect": "allow"
        },
        {
          "action": "shell",
          "resource": "jj log *",
          "effect": "allow"
        },
        {
          "action": "shell",
          "resource": "rtk jj log *",
          "effect": "allow"
        },
        {
          "action": "shell",
          "resource": "ls .jj",
          "effect": "allow"
        },
        {
          "action": "shell",
          "resource": "rtk ls .jj",
          "effect": "allow"
        },
        {
          "action": "shell",
          "resource": "test -d .jj *",
          "effect": "allow"
        },
        {
          "action": "shell",
          "resource": "rtk test -d .jj *",
          "effect": "allow"
        },
        {
          "action": "read",
          "resource": "*",
          "effect": "allow"
        },
        {
          "action": "glob",
          "resource": "*",
          "effect": "allow"
        },
        {
          "action": "grep",
          "resource": "*",
          "effect": "allow"
        },
        {
          "action": "webfetch",
          "resource": "*",
          "effect": "allow"
        },
        {
          "action": "skill",
          "resource": "*",
          "effect": "deny"
        },
        {
          "action": "subagent",
          "resource": "*",
          "effect": "deny"
        },
        {
          "action": "external_directory",
          "resource": "~/vaults/*",
          "effect": "deny"
        },
        {
          "action": "external_directory",
          "resource": "~/Library/CloudStorage/OneDrive-DNBBankASA/dnbrain/*",
          "effect": "deny"
        },
        {
          "action": "external_directory",
          "resource": "~/projects/*",
          "effect": "allow"
        },
        {
          "action": "external_directory",
          "resource": "/tmp/*",
          "effect": "allow"
        },
        {
          "action": "external_directory",
          "resource": "/var/folders/*",
          "effect": "allow"
        }
      ]
    },
    "sage": {
      "model": "raicode/anthropic/claude-opus-5-5"
    },
    "nabu": {
      "description": "Manage per-project memory notes in Obsidian vaults. Creates, reads, and updates structured Nabu notes based on the current repository's origin remote. Use for persisting session knowledge, project patterns, plans, and cross-project links. Also handles daily notes, work notes, and general note-taking in Obsidian vaults.",
      "mode": "subagent",
      "system": "{file:~/.config/opencode/prompts/nabu.md}\n\n---\n\n{file:~/.agents/skills/nabu/SKILL.md}\n\n---\n\n{file:~/.agents/skills/notes/SKILL.md}",
      "permissions": [
        {
          "action": "edit",
          "resource": "*",
          "effect": "allow"
        },
        {
          "action": "shell",
          "resource": "*",
          "effect": "allow"
        },
        {
          "action": "read",
          "resource": "*",
          "effect": "allow"
        },
        {
          "action": "glob",
          "resource": "*",
          "effect": "allow"
        },
        {
          "action": "grep",
          "resource": "*",
          "effect": "allow"
        }
      ]
    }
  },
  "providers": {
    "omlx": {
      "name": "oMLX (local)",
      "package": "@opencode/ai/providers/openai-compatible",
      "settings": {
        "baseURL": "http://localhost:8000/v1"
      },
      "models": {
        "mlx-community--gemma-4-26b-a4b-it-4bit": {
          "name": "Gemma 4 26B (MLX, 256K context)"
